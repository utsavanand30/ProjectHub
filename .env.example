# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=projecthub
POSTGRES_PASSWORD=projecthub_dev_password
POSTGRES_DB=projecthub
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Assembled by backend (do not change key name)
DATABASE_URL=postgresql://projecthub:projecthub_dev_password@db:5432/projecthub

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=replace_me_with_a_real_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── App ─────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── First admin (used by seed script) ───────────────────────────────────────
SEED_ADMIN_EMAIL=admin@projecthub.dev
SEED_ADMIN_PASSWORD=Admin@123456
SEED_ADMIN_NAME=System Admin
